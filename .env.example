# TEL-OS Paper — Environment Variables
# Copy this file to .env and fill in your keys.
# cp .env.example .env

# ─────────────────────────────────────────────
# REQUIRED — StrongREJECT evaluator (GPT-4o)
# Used by: all XP experiments
# Get at: https://platform.openai.com/api-keys
# ─────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─────────────────────────────────────────────
# REQUIRED for XP-37 (LRM Scale) — attacker APIs
# Each key is needed only for its respective attacker.
# ─────────────────────────────────────────────

# DeepSeek-R1 attacker
# Get at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...

# Qwen3-235B attacker (Alibaba DashScope)
# Get at: https://dashscope.aliyuncs.com
QWEN_API_KEY=sk-...

# Gemini 2.5 Flash attacker
# Get at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...

# ─────────────────────────────────────────────
# OPTIONAL — HuggingFace (model downloads)
# Required only if downloading gated models
# (Llama-3.1-8B-Instruct requires acceptance of Meta license)
# Get at: https://huggingface.co/settings/tokens
# ─────────────────────────────────────────────
HF_TOKEN=hf_...

# ─────────────────────────────────────────────
# OPTIONAL — Model endpoint overrides (XP-37)
# Defaults are set in the script; override only if needed.
# ─────────────────────────────────────────────
# QWEN_MODEL=qwen3-235b-a22b
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# GEMINI_MODEL=gemini-2.5-flash
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
